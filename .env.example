# ========================================================
# FaceAuth — Configurações do Supabase
# ========================================================
# Preencha as credenciais do seu projeto Supabase abaixo:

# URL do projeto Supabase (ex: https://abcdefghijklm.supabase.co)
SUPABASE_URL=

# Chave de API do Supabase (anon ou service_role)
SUPABASE_KEY=

# (Opcional) Connection String PostgreSQL para criação automática direta de tabelas
# DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres
